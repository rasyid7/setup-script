#!/usr/bin/env bash
# claude-rmsession — move a Claude Code session to the macOS Trash, by ID or by name.
#
#   claude-rmsession <id|id-prefix|name>...   remove session(s), asks for confirmation
#   claude-rmsession -l [filter]              list sessions (ID, name, cwd, last activity)
#   claude-rmsession -n <target>...           dry run: show what would be removed
#   claude-rmsession -y <target>...           remove without confirmation
#
# Name = /rename title (custom-title), else agent name, else the auto title (ai-title).
# Name matching is exact and case-insensitive. Running sessions are refused.
# Requires: jq. Bash 3.2 compatible (stock macOS).

set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PROJECTS="$CLAUDE_DIR/projects"
PROG="$(basename "$0")"
US=$'\037'   # field separator for the internal index

die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }

usage() {
  sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq)"
[ -d "$PROJECTS" ] || die "no sessions directory at $PROJECTS"

# --- index -------------------------------------------------------------------
# One row per session, fields separated by \x1f (US): id, name, mtime, path.
# Not TAB: bash `read` collapses empty TAB fields, which breaks untitled sessions.
build_index() {
  local files
  files="$(find "$PROJECTS" -mindepth 2 -maxdepth 2 -type f -name '*.jsonl' 2>/dev/null)"
  [ -n "$files" ] || return 0

  # Title lines -> path<TAB>priority<TAB>title (later lines override earlier ones).
  local titles
  titles="$(mktemp -t claude-rmsession)"
  printf '%s\n' "$files" | tr '\n' '\0' \
    | xargs -0 grep -H -E '^\{"type":"(custom-title|agent-name|ai-title)"' 2>/dev/null \
    | jq -R -r '
        (index(":{")) as $i
        | select($i != null)
        | .[0:$i] as $p
        | (try (.[$i+1:] | fromjson) catch null) as $o
        | select($o != null)
        | [$p,
           ({"custom-title":3, "agent-name":2, "ai-title":1}[$o.type]),
           ($o.customTitle // $o.agentName // $o.aiTitle // "" | gsub("[\t\n]"; " "))]
        | @tsv' > "$titles" || true

  printf '%s\n' "$files" | while IFS= read -r f; do
    local id mtime
    id="$(basename "$f" .jsonl)"
    mtime="$(stat -f '%m' "$f")"
    printf '%s\t%s\t%s\n' "$f" "$id" "$mtime"
  done | awk -F'\t' -v OFS='\037' '
    NR == FNR {
      if (NF < 3) next
      if (!($1 in pri) || $2 >= pri[$1]) { pri[$1] = $2; name[$1] = $3 }
      next
    }
    { print $2, (($1 in name) ? name[$1] : ""), $3, $1 }' "$titles" -
  rm -f "$titles"
}

session_cwd() {
  grep -m1 -o '"cwd":"[^"]*"' "$1" 2>/dev/null | sed 's/^"cwd":"//; s/"$//' | sed "s|^$HOME|~|" || true
}

fmt_time() { date -r "$1" '+%Y-%m-%d %H:%M'; }

# Session IDs that belong to a live Claude Code process.
running_ids() {
  local f pid sid
  for f in "$CLAUDE_DIR"/sessions/*.json; do
    [ -e "$f" ] || continue
    pid="$(jq -r '.pid // empty' "$f" 2>/dev/null || true)"
    sid="$(jq -r '.sessionId // empty' "$f" 2>/dev/null || true)"
    [ -n "$pid" ] && [ -n "$sid" ] && kill -0 "$pid" 2>/dev/null && echo "$sid"
  done
  return 0
}

print_rows() {  # stdin: index rows
  local id name mtime path
  while IFS=$US read -r id name mtime path; do
    printf '%s  %s  %-40.40s  %s\n' "$id" "$(fmt_time "$mtime")" "${name:-(untitled)}" "$(session_cwd "$path")"
  done
}

# --- resolve -----------------------------------------------------------------
# Prints matching index rows for one target.
resolve() {
  local target="$1" index="$2" lower hits
  if printf '%s' "$target" | grep -Eq '^[0-9a-fA-F-]{4,}$'; then
    lower="$(printf '%s' "$target" | tr 'A-F' 'a-f')"
    hits="$(printf '%s\n' "$index" | awk -F"$US" -v p="$lower" 'index($1, p) == 1')"
    if [ -n "$hits" ]; then printf '%s\n' "$hits"; return 0; fi
  fi
  printf '%s\n' "$index" | awk -F"$US" -v t="$target" 'tolower($2) == tolower(t) && $2 != ""'
}

# Everything on disk that belongs to a session.
artifacts_for() {
  local id="$1" path="$2" p
  echo "$path"
  for p in "$(dirname "$path")/$id" \
           "$CLAUDE_DIR/session-env/$id" \
           "$CLAUDE_DIR/file-history/$id"; do
    [ -e "$p" ] && echo "$p"
  done
  for p in "$CLAUDE_DIR"/todos/"$id"*; do
    [ -e "$p" ] && echo "$p"
  done
  return 0
}

to_trash() {
  if command -v trash >/dev/null 2>&1; then
    trash "$@"
  else
    local p dest
    for p in "$@"; do
      dest="$HOME/.Trash/$(basename "$p")"
      [ -e "$dest" ] && dest="$dest.$(date +%s)"
      mv "$p" "$dest"
    done
  fi
}

# --- main --------------------------------------------------------------------
mode=remove; yes=0
while getopts ':lnyh' opt; do
  case "$opt" in
    l) mode=list ;;
    n) mode=dry ;;
    y) yes=1 ;;
    h) usage 0 ;;
    *) warn "unknown option -$OPTARG"; usage 1 ;;
  esac
done
shift $((OPTIND - 1))

index="$(build_index | sort -t"$US" -k3,3nr)"

if [ "$mode" = list ]; then
  if [ $# -gt 0 ]; then
    printf '%s\n' "$index" | awk -F"$US" -v q="$*" 'index(tolower($1 " " $2 " " $4), tolower(q))' | print_rows
  else
    printf '%s\n' "$index" | grep -v '^$' | print_rows
  fi
  exit 0
fi

[ $# -gt 0 ] || usage 1

running="$(running_ids)"
status=0
to_remove=""

for target in "$@"; do
  hits="$(resolve "$target" "$index" | grep -v '^$' || true)"
  count="$(printf '%s' "$hits" | grep -c . || true)"
  if [ "$count" -eq 0 ]; then
    warn "no session matches '$target' (try: $PROG -l)"; status=1; continue
  fi
  if [ "$count" -gt 1 ]; then
    warn "'$target' matches $count sessions; use the ID instead:"
    printf '%s\n' "$hits" | print_rows >&2
    status=1; continue
  fi
  id="$(printf '%s' "$hits" | cut -d"$US" -f1)"
  if printf '%s\n' "$running" | grep -qx "$id"; then
    warn "session $id is still running; exit it first (/exit), then retry"; status=1; continue
  fi
  to_remove="$to_remove$hits"$'\n'
done

[ -n "$to_remove" ] || exit "$status"

echo "Sessions to move to Trash:"
paths=()
while IFS=$US read -r id name mtime path; do
  [ -n "$id" ] || continue
  echo
  echo "  ID:      $id"
  echo "  Name:    ${name:-(untitled)}"
  echo "  Folder:  $(session_cwd "$path")"
  echo "  Last:    $(fmt_time "$mtime")"
  while IFS= read -r a; do
    echo "    - ${a/#$HOME/~}"
    paths+=("$a")
  done < <(artifacts_for "$id" "$path")
done <<< "$to_remove"
echo

if [ "$mode" = dry ]; then
  echo "(dry run, nothing removed)"
  exit "$status"
fi

if [ "$yes" -ne 1 ]; then
  printf 'Move to Trash? [y/N] '
  read -r answer </dev/tty || answer=""
  case "$answer" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 1 ;; esac
fi

to_trash "${paths[@]}"
echo "Moved ${#paths[@]} item(s) to Trash."
exit "$status"
